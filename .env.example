# Auto AWS Asistent — konfigurace
# Zkopíruj na .env a vyplň. .env NIKDY necommituj do veřejného repa.

NODE_ENV=production
PORT=3000

# CORS: domény, ze kterých smí widget volat backend
ALLOWED_ORIGINS=https://www.autoaws.cz,https://autoaws.cz

# Eurouter AI (Claude Sonnet)
EUROUTER_API_KEY=
EUROUTER_MODEL=claude-sonnet-5
EUROUTER_URL=https://api.eurouter.ai/api/v1/chat/completions

# Limity provozu
RATE_LIMIT_MAX=40
MAX_SESSIONS=20000

# Volitelné: hlas (TTS/STT) — bez klíčů běží jen textový chat
# GOOGLE_TTS_API_KEY=
# ELEVENLABS_API_KEY=
