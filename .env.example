# Volitelné přepsání — výchozí hodnoty jsou v config.js (commitováno v repu).
# Stačí spustit: npm start

NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://www.autoaws.cz,https://autoaws.cz

EUROUTER_API_KEY=
EUROUTER_MODEL=claude-sonnet-5
EUROUTER_URL=https://api.eurouter.ai/api/v1/chat/completions

RATE_LIMIT_MAX=40
MAX_SESSIONS=20000
